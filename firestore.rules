rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Профили игроков: свой документ — ограниченный доступ, чужой — только чтение
    // (поиск/друзья) и поля друзей.
    // ВАЖНО: экономика сервер-авторитетна:
    // - gems 💎 (донат): клиент может только уменьшить (покупка), выдача — только сервером
    // - coins 🪙: клиент может только тратить (уменьшать); прирост — только Cloud Functions
    // - ratings/wins/games: пишет только сервер (submitResult, Admin SDK)
    // - admin: нельзя назначить себе самому (назначается в Firebase Console)
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.gems == 0;

      allow update: if request.auth != null && (
        // Свой документ: только трата монет/кристаллов, статистику и рейтинг
        // менять клиенту нельзя
        (request.auth.uid == userId
          && request.resource.data.get('gems', 0) <= resource.data.get('gems', 0)
          && request.resource.data.get('coins', 0) <= resource.data.get('coins', 0)
          && request.resource.data.get('ratings', null) == resource.data.get('ratings', null)
          && request.resource.data.get('wins', 0) == resource.data.get('wins', 0)
          && request.resource.data.get('games', 0) == resource.data.get('games', 0)
          && (resource.data.get('admin', false) == true
              || request.resource.data.get('admin', false) == false))
        ||
        // Чужой документ: только взаимные поля друзей
        (request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['friends', 'friendRequests']))
      );

      allow delete: if false;

      // Лимиты античита — читает/пишет только сервер (Admin SDK)
      match /meta/{docId} {
        allow read, write: if false;
      }
    }

    // Никаких других коллекций клиенту не нужно
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
