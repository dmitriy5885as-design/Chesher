{
  "rules": {
    ".read": false,
    ".write": false,

    "status": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "lobbies": {
      ".read": "auth != null",
      "$lobbyId": {
        ".write": "auth != null && (data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid || (data.child('guest').val() === null && newData.child('guest').val() === auth.uid) || (data.child('host').val() === null && newData.child('host').val() === auth.uid))"
      }
    },

    "codes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid)"
      }
    },

    "invites": {
      "$targetUid": {
        ".read": "auth != null && auth.uid === $targetUid",
        "$inviteKey": {
          ".write": "auth != null && (newData.child('from').val() === auth.uid || auth.uid === $targetUid)"
        }
      }
    },

    "friendChats": {
      "$chatId": {
        ".read": "auth != null && (chatId.matches(auth.uid + '_.*') || chatId.matches('.*_' + auth.uid))",
        "$msgKey": {
          ".write": "auth != null && (newData.child('by').val() === auth.uid || data.child('by').val() === auth.uid)"
        }
      }
    },

    "feedback": {
      ".write": true,
      ".read": false
    }
  }
}
